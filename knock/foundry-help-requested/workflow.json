{
  "name": "Foundry: help requested",
  "steps": [
    {
      "type": "channel",
      "template": {
        "subject": "✋ An agent needs you: {{ reason | truncate: 80 }}",
        "settings": {
          "layout_key": "default",
          "attachment_key": "attachments"
        },
        "preview_text": "{{ reason }}",
        "html_body@": "email_1/html_body.html"
      },
      "ref": "email_1",
      "channel_type": "email",
      "channel_key": "resend"
    }
  ],
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "foundry-help-requested",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
