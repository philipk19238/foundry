# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Values in .env win over .env.shared, which wins over the process environment.

# Sign-in
SEED_EMAIL=
SEED_PASSWORD=
SERVICE_TOKEN=
CREDENTIALS_KEY=

# Agents
KERNEL_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=

# Email (Knock development environment only: an sk_test_ key)
KNOCK_SECRET_KEY=

# Database: SQLite by default; Postgres for Modal
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres?ssl=require

# Attachments in Cloudflare R2 (FILES_STORAGE=r2; Modal always uses R2)
FILES_STORAGE=folder
FILES_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_API_TOKEN=

# Modal: deploys, and the redeploy a run asks for
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
