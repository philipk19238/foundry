# Copy to .env and fill in: the real settings (the Postgres database, R2, Modal). Git-ignored; never commit values.
# Values in .env win over .env.shared, which wins over the process environment. For local development, put
# overrides in .env.local (also git-ignored), which `just dev`, `just test` and `just migrate-local` load on top:
#   DATABASE_URL=sqlite+aiosqlite:///./foundry.db
#   FILES_STORAGE=folder
#   DISPATCHER=local

# Sign-in
SEED_EMAIL=
SEED_PASSWORD=
SERVICE_TOKEN=
CREDENTIALS_KEY=

# Agents
KERNEL_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=

# Email (Knock development environment only: an sk_test_ key)
KNOCK_SECRET_KEY=

# Database: SQLite by default; Postgres for Modal
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres?ssl=require

# Attachments in Cloudflare R2 (FILES_STORAGE=r2; Modal always uses R2)
FILES_STORAGE=folder
FILES_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_API_TOKEN=

# Modal: deploys, and the redeploy a run asks for
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# The web function's URL (printed by the first `just deploy`), for the links in emails sent from Modal
MODAL_BASE_URL=
