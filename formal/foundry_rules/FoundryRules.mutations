mutation a field drops its length header
detects decodeFuel_encode
- def encodeField (f : Bytes) : Bytes := header f.length ++ f
+ def encodeField (f : Bytes) : Bytes := f

mutation files are kept in portal order
detects sorted_canonFiles
- def canonFiles (fs : List Nat) : List Nat := fs.foldr insertSorted []
+ def canonFiles (fs : List Nat) : List Nat := fs

mutation the notice key forgets the due date
detects notice_same_iff
-   [tagNotice, l.source, l.anchorKind, l.anchor, l.title, l.dueAt, l.description, l.metadata]
+   [tagNotice, l.source, l.anchorKind, l.anchor, l.title, l.description, l.metadata]

mutation the opportunity key includes the title
detects opportunity_ignores_dynamic
- def opportunityKey (l : Listing) : List Bytes := [tagOpportunity, l.source, l.anchorKind, l.anchor]
+ def opportunityKey (l : Listing) : List Bytes := [tagOpportunity, l.source, l.anchorKind, l.anchor, l.title]

mutation ingest overwrites instead of skipping
detects ingestAll_idempotent
- def ingest (catalog : List Bytes) (n : Bytes) : List Bytes := if n ∈ catalog then catalog else catalog ++ [n]
+ def ingest (catalog : List Bytes) (n : Bytes) : List Bytes := catalog ++ [n]

mutation the silent-breakage gate is dropped
detects silent_breakage_heals
-   else if c.crashed || decide (c.invalid > 0) || (decide (c.valid = 0) && decide (c.previousValid > 0)) then .heal
+   else if c.crashed || decide (c.invalid > 0) then .heal

mutation heal budget check is off by one
detects heals_bounded
-   | .relogin => if h.heals < maxHeals then ⟨.relogin, h.heals + 1⟩ else ⟨.needsHuman, h.heals⟩
-   | .heal => if h.heals < maxHeals then ⟨.healing, h.heals + 1⟩ else ⟨.needsHuman, h.heals⟩
+   | .relogin => if h.heals < maxHeals then ⟨.relogin, h.heals + 1⟩ else ⟨.needsHuman, h.heals⟩
+   | .heal => if h.heals ≤ maxHeals then ⟨.healing, h.heals + 1⟩ else ⟨.needsHuman, h.heals⟩

mutation a relogin stops spending the budget
detects relogin_loop_reaches_human
-   | .relogin => if h.heals < maxHeals then ⟨.relogin, h.heals + 1⟩ else ⟨.needsHuman, h.heals⟩
+   | .relogin => ⟨.relogin, h.heals⟩

mutation the anchor drops its kind
detects opportunity_same_iff
- def opportunityKey (l : Listing) : List Bytes := [tagOpportunity, l.source, l.anchorKind, l.anchor]
+ def opportunityKey (l : Listing) : List Bytes := [tagOpportunity, l.source, l.anchor]

mutation an agent working beats a question waiting
detects stage_waiting_first
-   if waiting then .waiting
-   else if working then .building
+   if working then .building
+   else if waiting then .waiting

mutation a version in review beats an agent working
detects stage_working_second
-   else if working then .building
-   else if reviewing then .review
+   else if reviewing then .review
+   else if working then .building

mutation the status is read before the review
detects stage_review_third
-   else if reviewing then .review
-   else if status = .ready then .live
+   else if status = .ready then .live
+   else if reviewing then .review

mutation a relogging source still shows live
detects stage_live_iff
-   else if status = .ready then .live
+   else if status = .ready ∨ status = .relogin then .live

mutation a source with nothing under way is never stopped
detects stage_stopped_iff
-   else if status = .ready then .live
-   else .stopped
+   else if status = .ready then .live
+   else .building

mutation a version in review shows as building
detects stage_reachable
-   else if reviewing then .review
+   else if reviewing then .building

mutation the home page passes waiting and working swapped
detects home_agrees_with_page
-   stageOf status inWorking inWaiting inReviewing
+   stageOf status inWaiting inWorking inReviewing

mutation working forgets that the source is live
detects working_never_onboards_live
-   else if st.live then none
-   else some .onboarding
+   else some .onboarding

mutation a live source is marked ready while the agent works
detects working_keeps_live
-   else if st.live then none
+   else if st.live then some .ready

mutation a rejected heal of a live scraper goes back to ready
detects settled_live
-   if rejected = true ∧ k = .heal then .needsHuman
+   if rejected = true ∧ k = .heal ∧ st.live = false then .needsHuman

mutation any rejected job goes to a person
detects settled_in_review
-   if rejected = true ∧ k = .heal then .needsHuman
+   if rejected = true then .needsHuman

mutation a version in review is forgotten after a job
detects settled_in_review
-   else if st.proposed then .inReview
+   else if st.proposed then .needsHuman

mutation a source with no versions goes back to onboarding
detects settled_not_busy
-   else if st.proposed then .inReview
-   else .needsHuman
+   else if st.proposed then .inReview
+   else .onboarding

mutation a rejected heal leaves the source healing
detects settled_not_busy
-   if rejected = true ∧ k = .heal then .needsHuman
+   if rejected = true ∧ k = .heal then .healing

mutation ties on first_seen_at are not broken by notice_id
detects naive_tie_two_rows
- def Notice.before (a b : Notice) : Bool := decide (a.seen > b.seen ∨ (a.seen = b.seen ∧ a.id > b.id))
+ def Notice.before (a b : Notice) : Bool := decide (a.seen > b.seen)

mutation the newest notice ranks last
detects opportunities_newest
- def Notice.before (a b : Notice) : Bool := decide (a.seen > b.seen ∨ (a.seen = b.seen ∧ a.id > b.id))
+ def Notice.before (a b : Notice) : Bool := decide (a.seen < b.seen ∨ (a.seen = b.seen ∧ a.id < b.id))

mutation row_number is not partitioned by opportunity
detects rowNumber_one_iff
-   (ns.filter fun m => m.opp == n.opp && m.before n).length + 1
+   (ns.filter fun m => m.before n).length + 1

mutation the join keeps rank 2 as well
detects opportunities_one_each
-   ns.filter fun n => rowNumber ns n == 1
+   ns.filter fun n => rowNumber ns n ≤ 2

mutation the join takes rows from outside the notice table
detects opportunities_stored
-   ns.filter fun n => rowNumber ns n == 1
+   ns.filter (fun n => rowNumber ns n == 1) ++ [⟨0, 0, 0⟩]

mutation the snapshot count is partitioned by notice
detects snapshots_counts
-   (ns.filter fun m => m.opp == n.opp).length
+   (ns.filter fun m => m.id == n.id).length

mutation went_through drops the base floor
detects paceStep_in_range
- def wentThrough (ease : Nat → Nat) (base d : Nat) : Nat := max base (ease d)
+ def wentThrough (ease : Nat → Nat) (base d : Nat) : Nat := ease d

mutation limited loses the SLOWEST cap on the pace
detects paceStep_in_range
-   let slower := max base (min slowest (max (d * 2) firstSlowdown))
+   let slower := max base (max (d * 2) firstSlowdown)

mutation limited loses the base floor (the pre-fix code)
detects paceStep_in_range
-   let slower := max base (min slowest (max (d * 2) firstSlowdown))
+   let slower := min slowest (max (d * 2) firstSlowdown)

mutation the Retry-After wait has no SLOWEST cap
detects retry_after_wait_le_slowest
-   ⟨slower, if ra = 0 then slower else min slowest ra⟩
+   ⟨slower, if ra = 0 then slower else ra⟩

mutation a bare limit waits twice the new pace
detects limited_wait_le
-   ⟨slower, if ra = 0 then slower else min slowest ra⟩
+   ⟨slower, if ra = 0 then slower * 2 else min slowest ra⟩

mutation the Retry-After becomes the pace
detects limited_pace_ignores_retry_after
-   ⟨slower, if ra = 0 then slower else min slowest ra⟩
+   ⟨if ra = 0 then slower else min slowest ra, if ra = 0 then slower else min slowest ra⟩

mutation the Retry-After becomes the pace, below base
detects paceStep_in_range
-   ⟨slower, if ra = 0 then slower else min slowest ra⟩
+   ⟨if ra = 0 then slower else ra, if ra = 0 then slower else min slowest ra⟩

mutation limited goes back to the or FIRST_SLOWDOWN
detects limited_at_least_first
-   let slower := max base (min slowest (max (d * 2) firstSlowdown))
+   let slower := max base (min slowest (if d * 2 = 0 then firstSlowdown else d * 2))

mutation a limit no longer doubles the pace
detects limited_doubles
-   let slower := max base (min slowest (max (d * 2) firstSlowdown))
+   let slower := max base (min slowest firstSlowdown)

mutation easing slows the site down instead
- def half (d : Nat) : Nat := d / 2
+ def half (d : Nat) : Nat := d * 2

mutation successes never ease the pace
detects halves
- def half (d : Nat) : Nat := d / 2
+ def half (d : Nat) : Nat := d

mutation _paced hands an unsolvable bot check back after two slower tries
detects unsolvable_check_one_slower_try
-     if hurrying || (decide (tries > 0) && !solve && ch) then []
+     if hurrying || (decide (tries > 1) && !solve && ch) then []

mutation _paced hands a bot check back without a slower try
detects unsolvable_check_one_slower_try
-     if hurrying || (decide (tries > 0) && !solve && ch) then []
+     if hurrying || (!solve && ch) then []

mutation _paced hands back bot checks the spider can solve
-     if hurrying || (decide (tries > 0) && !solve && ch) then []
+     if hurrying || (decide (tries > 0) && ch) then []

mutation _paced keeps slowing a stopping crawl
-     if hurrying || (decide (tries > 0) && !solve && ch) then []
+     if (decide (tries > 0) && !solve && ch) then []

mutation FilesPipeline logs the line before writing the content
-   | some l, _ => some { w with disk := { w.disk with log := w.disk.log ++ [l] }, pending := none }
-   | none, l :: rest => some { w with disk := { w.disk with files := addNew l.digest w.disk.files }, pending := some l, todo := rest }
+   | some l, _ => some { w with disk := { w.disk with files := addNew l.digest w.disk.files }, pending := none }
+   | none, l :: rest => some { w with disk := { w.disk with log := w.disk.log ++ [l] }, pending := some l, todo := rest }

mutation Uploads.saved only records lines past the cursor
-   w.disk.log.foldl (fun s l => addNew l.url s) w.saved
+   (w.disk.log.drop w.disk.cursor).foldl (fun s l => addNew l.url s) w.saved

mutation a new attempt takes every logged line as uploaded
-   { w with pc := .check, pending := none, todo := w.pending.toList ++ w.todo, saved := [], crashes := w.crashes + 1 }
+   { w with disk := { w.disk with cursor := w.disk.log.length }, pc := .check, pending := none, todo := w.pending.toList ++ w.todo, saved := [], crashes := w.crashes + 1 }

