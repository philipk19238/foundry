    {
      "kind": "theorem",
      "name": "Foundry.notice_determines_opportunity",
      "type": "∀ (digest : Nat → Foundry.Bytes), (∀ (x y : Nat), digest x = digest y → x = y) → ∀ (a b : Foundry.Listing), Foundry.Fits (Foundry.noticeKey digest a) → Foundry.Fits (Foundry.noticeKey digest b) → Foundry.encode (Foundry.noticeKey digest a) = Foundry.encode (Foundry.noticeKey digest b) → Foundry.encode (Foundry.opportunityKey a) = Foundry.encode (Foundry.opportunityKey b)",
      "typeHash": "10370282637289880811",
      "valueHash": null
    },
    {
      "kind": "theorem",
      "name": "Foundry.notice_same_iff",
      "type": "∀ (digest : Nat → Foundry.Bytes), (∀ (x y : Nat), digest x = digest y → x = y) → ∀ (a b : Foundry.Listing), Foundry.Fits (Foundry.noticeKey digest a) → Foundry.Fits (Foundry.noticeKey digest b) → (Foundry.encode (Foundry.noticeKey digest a) = Foundry.encode (Foundry.noticeKey digest b) ↔ Foundry.SameContent a b)",
      "typeHash": "15568459515117299756",
      "valueHash": null
    },
    {
      "kind": "theorem",
      "name": "Foundry.old_or_quiet_spell_below_first",
      "type": "Foundry.limitedOr (Foundry.paceRun Foundry.half 0 0 [Foundry.PaceEvent.limit 0, Foundry.PaceEvent.ok, Foundry.PaceEvent.ok]) < Foundry.firstSlowdown",
      "typeHash": "5515786560674288632",
      "valueHash": null
    },
