    {
      "kind": "theorem",
      "name": "Foundry.opportunity_ignores_dynamic",
      "type": "∀ (a b : Foundry.Listing), a.source = b.source → a.anchorKind = b.anchorKind → a.anchor = b.anchor → Foundry.encode (Foundry.opportunityKey a) = Foundry.encode (Foundry.opportunityKey b)",
      "typeHash": "13189476859463740776",
