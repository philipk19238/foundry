      "name": "Foundry.settled_in_review",
      "type": "∀ (st : Foundry.Standing) (k : Foundry.JobKind) (r : Bool), st.live = false → st.proposed = true → ¬(r = true ∧ k = Foundry.JobKind.heal) → st.settled k r = Foundry.SourceStatus.inReview",
