      "type": "(Foundry.naiveOpportunities [{ opp := 1, seen := 5, id := 10 }, { opp := 1, seen := 5, id := 11 }]).length = 2 ∧ (Foundry.opportunities [{ opp := 1, seen := 5, id := 10 }, { opp := 1, seen := 5, id := 11 }]).length = 1",
      "typeHash": "3417092444555713633",
