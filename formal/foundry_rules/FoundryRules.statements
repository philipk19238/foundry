      "type": "∀ (h : Foundry.Health) (c : Foundry.Crawl), (Foundry.afterCrawl h c).status = Foundry.Status.needsHuman → Foundry.verdict c ≠ Foundry.Verdict.healthy ∧ Foundry.maxHeals ≤ h.heals",
