      "type": "∀ (st : Foundry.Standing) (k : Foundry.JobKind) (r : Bool), st.live = true → st.settled k r = if r = true ∧ k = Foundry.JobKind.heal then Foundry.SourceStatus.needsHuman else Foundry.SourceStatus.ready",
      "typeHash": "8064944202926604393",
