    {
      "kind": "theorem",
      "name": "Foundry.naive_collides",
      "type": "Foundry.naive [[97, 98], [99]] = Foundry.naive [[97], [98, 99]] ∧ [[97, 98], [99]] ≠ [[97], [98, 99]]",
      "typeHash": "13412586505834938537",
      "valueHash": null
    },
    {
      "kind": "theorem",
      "name": "Foundry.naive_misses_silent_breakage",
      "type": "Foundry.naiveVerdict { authFailed := false, crashed := false, invalid := 0, valid := 0, previousValid := 12 } = Foundry.Verdict.healthy ∧ Foundry.verdict { authFailed := false, crashed := false, invalid := 0, valid := 0, previousValid := 12 } = Foundry.Verdict.heal",
      "typeHash": "16977596982286222595",
      "valueHash": null
    },
    {
      "kind": "theorem",
      "name": "Foundry.naive_relogin_loops_forever",
      "type": "∀ (n : Nat), (Nat.repeat (fun h => Foundry.naiveAfterCrawl h Foundry.loggedOut) n { status := Foundry.Status.ready, heals := 0 }).status ≠ Foundry.Status.needsHuman",
      "typeHash": "5840943663862863098",
      "valueHash": null
    },
    {
      "kind": "theorem",
      "name": "Foundry.naive_tie_two_rows",
      "type": "(Foundry.naiveOpportunities [{ opp := 1, seen := 5, id := 10 }, { opp := 1, seen := 5, id := 11 }]).length = 2 ∧ (Foundry.opportunities [{ opp := 1, seen := 5, id := 10 }, { opp := 1, seen := 5, id := 11 }]).length = 1",
      "typeHash": "3417092444555713633",
      "valueHash": null
    },
    {
      "kind": "theorem",
      "name": "Foundry.naive_working_onboards_live",
      "type": "Foundry.naiveWorking { live := true, proposed := false } Foundry.JobKind.onboard = some Foundry.SourceStatus.onboarding",
      "typeHash": "9679819302546634520",
      "valueHash": null
    },
    {
      "kind": "theorem",
      "name": "Foundry.needsHuman_only_when_exhausted",
      "type": "∀ (h : Foundry.Health) (c : Foundry.Crawl), (Foundry.afterCrawl h c).status = Foundry.Status.needsHuman → Foundry.verdict c ≠ Foundry.Verdict.healthy ∧ Foundry.maxHeals ≤ h.heals",
      "typeHash": "10437720571658923909",
      "valueHash": null
    },
