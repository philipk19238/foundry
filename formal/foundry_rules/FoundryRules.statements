    {
      "kind": "theorem",
      "name": "Foundry.opportunities_newest",
      "type": "∀ (ns : List Foundry.Notice), Foundry.UniqueIds ns → ∀ (n m : Foundry.Notice), n ∈ Foundry.opportunities ns → m ∈ ns → m.opp = n.opp → m ≠ n → m.seen < n.seen ∨ m.seen = n.seen ∧ m.id < n.id",
      "typeHash": "2731456832085093224",
      "valueHash": null
    },
    {
      "kind": "theorem",
      "name": "Foundry.opportunities_one_each",
      "type": "∀ (ns : List Foundry.Notice), Foundry.UniqueIds ns → ∀ (o : Nat), (∃ n, n ∈ ns ∧ n.opp = o) → (List.filter (fun n => n.opp == o) (Foundry.opportunities ns)).length = 1",
      "typeHash": "14243546103434465476",
      "valueHash": null
    },
    {
      "kind": "theorem",
      "name": "Foundry.opportunities_stored",
